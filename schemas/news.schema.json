{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "NewsList",
  "type": "object",
  "required": ["news"],
  "properties": {
    "news": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "slug", "title", "summary", "publishedAt"],
        "properties": {
          "id": { "type": "string" },
          "slug": { "type": "string" },
          "title": { "type": "string" },
          "summary": { "type": "string" },
          "content": { "type": "string" },
          "image": { "type": ["string", "null"] },
          "publishedAt": { "type": "string" },
          "source": { "type": "string" },
          "url": { "type": ["string", "null"] },
          "tags": { "type": "array", "items": { "type": "string" } },
          "relatedTeamIds": { "type": "array", "items": { "type": "string" } },
          "relatedPlayerIds": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}

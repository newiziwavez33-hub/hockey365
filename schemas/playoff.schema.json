{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PlayoffBracket",
  "type": "object",
  "required": ["compId", "season", "rounds"],
  "properties": {
    "compId": { "type": "string" },
    "season": { "type": "string" },
    "rounds": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["roundNumber", "roundName", "series"],
        "properties": {
          "roundNumber": { "type": "integer" },
          "roundName": { "type": "string" },
          "series": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["seriesId", "homeTeamId", "awayTeamId", "wins", "bestOf", "status"],
              "properties": {
                "seriesId": { "type": "string" },
                "homeTeamId": { "type": "string" },
                "awayTeamId": { "type": "string" },
                "wins": { "type": "array", "items": { "type": "integer" } },
                "bestOf": { "type": "integer" },
                "status": { "type": "string", "enum": ["SCHEDULED", "LIVE", "FINISHED"] },
                "games": { "type": "array", "items": { "type": "string" } }
              }
            }
          }
        }
      }
    }
  }
}
